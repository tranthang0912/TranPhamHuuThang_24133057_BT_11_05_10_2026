<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0" metadata-complete="true">
    <display-name>Video Management 24133057</display-name>
    <listener><listener-class>huuthang.config.ActivationEmailListener_24133057</listener-class></listener>
    <servlet>
        <servlet-name>activationController_24133057</servlet-name>
        <servlet-class>huuthang.controller.ActivationController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>activationController_24133057</servlet-name>
        <url-pattern>/account/activate</url-pattern>
        <url-pattern>/account/videos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>commerceController_24133057</servlet-name>
        <servlet-class>huuthang.controller.CommerceController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>commerceController_24133057</servlet-name>
        <url-pattern>/shop</url-pattern>
        <url-pattern>/cart</url-pattern>
        <url-pattern>/checkout</url-pattern>
        <url-pattern>/orders</url-pattern>
        <url-pattern>/orders/detail</url-pattern>
        <url-pattern>/orders/cancel</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>homeController_24133057</servlet-name>
        <servlet-class>huuthang.controller.HomeController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>homeController_24133057</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>videoController_24133057</servlet-name>
        <servlet-class>huuthang.controller.VideoController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>videoController_24133057</servlet-name>
        <url-pattern>/videos</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>videoController_24133057</servlet-name>
        <url-pattern>/videos/detail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>videoController_24133057</servlet-name>
        <url-pattern>/videos/favorite</url-pattern>
        <url-pattern>/videos/favorites</url-pattern>
        <url-pattern>/videos/share</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>authController_24133057</servlet-name>
        <servlet-class>huuthang.controller.AuthController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>authController_24133057</servlet-name>
        <url-pattern>/auth/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController_24133057</servlet-name>
        <url-pattern>/auth/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController_24133057</servlet-name>
        <url-pattern>/auth/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController_24133057</servlet-name>
        <url-pattern>/auth/verify-otp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>profileController_24133057</servlet-name>
        <servlet-class>huuthang.controller.ProfileController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>profileController_24133057</servlet-name>
        <url-pattern>/account/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>adminHomeController_24133057</servlet-name>
        <servlet-class>huuthang.controller.AdminHomeController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>adminHomeController_24133057</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>adminHomeController_24133057</servlet-name>
        <url-pattern>/admin/</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>adminOrderController_24133057</servlet-name>
        <servlet-class>huuthang.controller.AdminOrderController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>adminOrderController_24133057</servlet-name>
        <url-pattern>/admin/orders</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>adminUserController_24133057</servlet-name>
        <servlet-class>huuthang.controller.AdminUserController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>adminUserController_24133057</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>adminUserController_24133057</servlet-name>
        <url-pattern>/admin/users/form</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>adminUserController_24133057</servlet-name>
        <url-pattern>/admin/users/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>jspCompatibilityController_24133057</servlet-name>
        <servlet-class>huuthang.controller.JspCompatibilityController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>jspCompatibilityController_24133057</servlet-name>
        <url-pattern>/system/jsp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>errorController_24133057</servlet-name>
        <servlet-class>huuthang.controller.ErrorController_24133057</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>errorController_24133057</servlet-name>
        <url-pattern>/error</url-pattern>
    </servlet-mapping>

    <filter>
        <filter-name>characterEncoding_24133057</filter-name>
        <filter-class>huuthang.filter.CharacterEncodingFilter_24133057</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>characterEncoding_24133057</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
        <dispatcher>INCLUDE</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>

    <filter>
        <filter-name>adminAuthorization_24133057</filter-name>
        <filter-class>huuthang.filter.AdminFilter_24133057</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>adminAuthorization_24133057</filter-name>
        <url-pattern>/admin</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>adminAuthorization_24133057</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>sitemesh_24133057</filter-name>
        <filter-class>huuthang.filter.LayoutFilter_24133057</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>sitemesh_24133057</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>404</error-code>
        <location>/error</location>
    </error-page>
    <error-page><error-code>400</error-code><location>/error</location></error-page>
    <error-page><error-code>403</error-code><location>/error</location></error-page>
    <error-page><error-code>405</error-code><location>/error</location></error-page>
    <error-page><error-code>429</error-code><location>/error</location></error-page>
    <error-page><error-code>503</error-code><location>/error</location></error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error</location>
    </error-page>
</web-app>
