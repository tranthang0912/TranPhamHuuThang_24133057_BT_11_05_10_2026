<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<html lang="vi"><head><title>Kích hoạt video | Hữu Thắng</title></head><body>
<main class="container commerce-page activation-page"><div class="commerce-heading"><div><span class="eyebrow">BẮT ĐẦU HÀNH TRÌNH HỌC</span><h1>Kích hoạt video</h1><p>Một mã, một tài khoản. Video của bạn luôn sẵn sàng trong thư viện.</p></div><a class="button outline" href="<c:url value='/account/videos'/>">Video của tôi</a></div>
<div class="activation-layout"><section class="commerce-panel"><span class="activation-icon">▶</span><h2>Bạn đã có mã kích hoạt?</h2><p class="muted">Sao chép mã từ email hoặc chi tiết đơn hàng sau khi thanh toán COD thành công.</p>
<c:if test="${not empty error}"><div class="alert error" role="alert"><c:out value="${error}"/></div></c:if>
<form class="stack-form" method="post" action="<c:url value='/account/activate'/>"><input type="hidden" name="csrfToken" value="${videoCsrf}"><label for="activation-code">Mã kích hoạt video<input id="activation-code" class="activation-input" name="code" minlength="32" maxlength="64" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Nhập hoặc dán mã 32 ký tự" required aria-describedby="code-hint"></label><small class="input-hint" id="code-hint">Mã chỉ dùng một lần. Kiểm tra tài khoản đang đăng nhập trước khi kích hoạt.</small><button class="button primary full" type="submit">Kích hoạt và bắt đầu học →</button></form></section>
<aside class="activation-help"><span class="eyebrow">TỪ ĐẶT HÀNG ĐẾN BẮT ĐẦU HỌC</span><ol><li><b>01</b><div><strong>Chọn video và đặt COD</strong><p>Nhập thông tin nhận hàng để hoàn tất đơn.</p></div></li><li><b>02</b><div><strong>Nhận hàng và thanh toán</strong><p>Khi đơn đã giao và đã thu tiền, mã được cấp theo số lượng bạn mua.</p></div></li><li><b>03</b><div><strong>Nhận mã, kích hoạt và học</strong><p>Mã có trong email và chi tiết đơn hàng. Mỗi mã mở video cho một tài khoản.</p></div></li></ol><a class="button outline" href="<c:url value='/orders'/>">Lấy mã từ đơn hàng</a><p class="muted">Nếu đơn được hoàn, mã và quyền xem từ đơn đó sẽ được thu hồi.</p></aside></div></main>
</body></html>
