<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<html lang="vi"><head><title>Đơn #${order.orderId} | Hữu Thắng</title></head><body>
<fmt:setLocale value="vi_VN"/><fmt:setTimeZone value="Asia/Ho_Chi_Minh"/>
<main class="container commerce-page">
    <div class="commerce-heading"><div><span class="eyebrow">CHI TIẾT ĐƠN HÀNG</span><h1>Đơn #${order.orderId}</h1><p>Đặt lúc <fmt:formatDate value="${order.createdAt}" pattern="dd/MM/yyyy HH:mm"/></p></div><a class="button outline" href="<c:url value='/orders'/>">Lịch sử đặt hàng</a></div>
    <c:if test="${not empty flashSuccess}"><div class="alert success" role="status"><c:out value="${flashSuccess}"/></div></c:if>
    <div class="commerce-columns"><div class="order-detail-main"><section class="commerce-panel"><div class="order-section-heading"><h2>Video đã đặt</h2><span class="order-status status-${order.status.code}"><c:out value="${order.status.label}"/></span></div>
        <c:forEach items="${order.items}" var="item"><div class="checkout-line"><div><strong><c:out value="${item.title}"/></strong><small>${item.quantity} bộ × <fmt:formatNumber value="${item.unitPrice}" maxFractionDigits="0"/> ₫</small></div><b><fmt:formatNumber value="${item.subtotal}" maxFractionDigits="0"/> ₫</b></div></c:forEach>
        <div class="summary-row"><span>Phí giao hàng</span><strong>Miễn phí</strong></div><div class="summary-row summary-total"><span>Tổng đơn hàng</span><strong><fmt:formatNumber value="${order.total}" maxFractionDigits="0"/> ₫</strong></div><p><strong>COD:</strong> <c:out value="${order.paymentLabel}"/></p>
    </section><section class="commerce-panel"><h2>Thông tin nhận hàng</h2><dl class="shipping-info"><dt>Người nhận</dt><dd><c:out value="${order.recipient}"/></dd><dt>Điện thoại</dt><dd><c:out value="${order.phone}"/></dd><dt>Địa chỉ</dt><dd><c:out value="${order.address}"/></dd><c:if test="${not empty order.note}"><dt>Ghi chú</dt><dd class="order-note"><c:out value="${order.note}"/></dd></c:if></dl></section>
    <section class="commerce-panel activation-codes"><div class="order-section-heading"><h2>Mã kích hoạt video</h2><c:if test="${order.status.code == 'DELIVERED'}"><span class="order-status status-DELIVERED">Sẵn sàng</span></c:if></div>
        <c:choose><c:when test="${order.status.code == 'CANCELLED'}"><p class="muted">Đơn đã hủy. Không cấp mã kích hoạt.</p></c:when><c:when test="${order.status.code == 'RETURNED'}"><div class="alert error">Đơn đã hoàn. Các mã và quyền xem video từ đơn này đã được thu hồi.</div></c:when><c:when test="${not empty activationCodes}">
            <p class="muted">Mỗi bộ video tương ứng một mã cho một tài khoản. Bạn có thể dùng mã cho mình hoặc tặng mã chưa sử dụng cho người khác.</p>
            <c:choose><c:when test="${activationEmailStatus == 'SENT'}"><div class="alert success">Mã đã được gửi tới email tài khoản đặt hàng.</div></c:when><c:when test="${activationEmailStatus == 'FAILED'}"><div class="alert error">Email chưa gửi thành công. Bạn có thể lấy mã bên dưới để kích hoạt ngay.</div></c:when><c:otherwise><div class="alert">Email chưa được gửi. Bạn có thể sao chép mã bên dưới và kích hoạt ngay.</div></c:otherwise></c:choose>
            <c:forEach items="${activationCodes}" var="code" varStatus="row"><div class="activation-code-row"><div class="order-section-heading"><strong><c:out value="${code.title}"/></strong><span class="code-status"><c:out value="${code.statusLabel}"/></span></div><c:if test="${code.status == 'AVAILABLE'}"><div class="code-copy-row"><label class="visually-hidden" for="code-${row.index}">Mã kích hoạt <c:out value="${code.title}"/></label><input id="code-${row.index}" class="code-input" value="<c:out value='${code.code}'/>" readonly><button class="button outline" type="button" data-copy-code="code-${row.index}">Sao chép</button><span class="input-hint" role="status" data-code-feedback></span></div></c:if></div></c:forEach>
            <a class="button primary" href="<c:url value='/account/activate'/>">Nhập mã để kích hoạt video →</a>
        </c:when><c:otherwise><div class="activation-pending"><span>✉</span><div><strong>Mã sẽ được cấp sau khi thanh toán COD</strong><p>Khi đơn chuyển sang “Đã giao” và đã thu đủ tiền, mã sẽ xuất hiện ở đây và được gửi qua email tài khoản.</p></div></div></c:otherwise></c:choose>
    </section></div><aside class="commerce-panel order-summary"><h2>Tiến trình đơn hàng</h2><ol class="order-timeline"><c:forEach items="${order.events}" var="event"><li><span class="timeline-dot"></span><div><strong><c:out value="${event.status.label}"/></strong><small><fmt:formatDate value="${event.changedAt}" pattern="dd/MM/yyyy HH:mm:ss"/></small></div></li></c:forEach></ol>
        <c:url var="refreshUrl" value="/orders/detail"><c:param name="id" value="${order.orderId}"/></c:url><a class="button outline full" href="${refreshUrl}">Làm mới trạng thái</a>
        <c:if test="${order.status.cancellable}"><form method="post" action="<c:url value='/orders/cancel'/>" class="cancel-order-form" data-confirm="Bạn muốn hủy đơn hàng này? Số lượng sẽ được hoàn lại."><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="id" value="${order.orderId}"><button class="button danger-button full" type="submit">Hủy đơn hàng</button></form><p class="muted">Bạn có thể hủy khi đơn mới hoặc đã xác nhận.</p></c:if>
    </aside></div>
</main></body></html>
